{
  "name": "pangea-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Pangea desktop app: builds and installs Pangea plugins into Logic on the user's Mac",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
