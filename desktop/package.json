    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "mock": "node mock-server/server.mjs",
    "check": "pnpm typecheck && cd src-tauri && cargo check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.6"
  }
}
